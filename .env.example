# Option Riders — Trade Journal config
# Copy this file to `.env` and fill in your own values.
# DO NOT commit `.env` to git — it contains credentials.

# ── IBKR Flex Web Service ───────────────────────────────────────────
# In IBKR Client Portal → Performance & Reports → Flex Queries:
#   1. Create a Custom Flex Query (Activity type, section: Trades).
#      Include these columns at minimum:
#        Symbol, AssetClass, DateTime, TradeDate, Quantity, TradePrice,
#        Proceeds, IBCommission, FifoPnlRealized, FXRateToBase, CostBasis,
#        Open/CloseIndicator, Buy/Sell, Put/Call, Strike, Expiry, Multiplier,
#        UnderlyingSymbol, TradeID, Currency.
#   2. Enable the Flex Web Service under Reports → Settings → Flex Web Service,
#      and generate a token.
#   3. Paste the token and the query's numeric ID below.
IBKR_FLEX_TOKEN=
IBKR_FLEX_QUERY_ID=

# ── OptionRiders TradingView bundle ───────────────────────────────
TRADINGVIEW_PRODUCT_NAME=OptionRiders TradingView Script Bundle
TRADINGVIEW_PRODUCT_DESCRIPTION=Both private OptionRiders indicators, including ongoing updates.
TRADINGVIEW_MONTHLY_LINK=
TRADINGVIEW_MONTHLY_NAME=Monthly Access
TRADINGVIEW_MONTHLY_PRICE=$39/month
TRADINGVIEW_MONTHLY_DESCRIPTION=Monthly access to both OptionRiders TradingView scripts, including ongoing updates.
TRADINGVIEW_LIFETIME_LINK=
TRADINGVIEW_LIFETIME_NAME=Lifetime Access
TRADINGVIEW_LIFETIME_PRICE=$400 one-time
TRADINGVIEW_LIFETIME_DESCRIPTION=One payment for lifetime access to both OptionRiders TradingView scripts.

# Comma-separated Supabase account emails permitted to use /script-access.
ACCESS_ADMIN_EMAILS=
