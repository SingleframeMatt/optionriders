dsmaLen4    = input.int(100,   "SMA Length 4",                 minval=1, maxval=500, group=GD)
dsmaCol4    = input.color(color.new(#FFFFFF, 0),  "  └ Color",  group=GD)
dsmaLen5    = input.int(200,   "SMA Length 5",                 minval=1, maxval=500, group=GD)
dsmaCol5    = input.color(color.new(#FFFFFF, 0),  "  └ Color",  group=GD)

// ── 12. ORB ───────────────────────────────────────────────────────────────────
GORB        = "📐 ORB"
showORB     = input.bool(true,  "Show Opening Range (ORB)",           group=GORB, tooltip="Draws the high and low of the opening range from the RTH open (9:30 ET).")
orbMins     = input.int(15,     "ORB Length (minutes)",               minval=5, maxval=60, group=GORB, tooltip="How many minutes from 9:30 ET define the Opening Range. 15 is the most common.")
showORBFill = input.bool(true,  "  └ Show Filled Block",              group=GORB, tooltip="Fills the opening range with a solid colour block. Use the colour picker to set hue and transparency.")
orbFillCol  = input.color(color.new(#64B5F6, 80), "  └ Fill Color",   group=GORB)
