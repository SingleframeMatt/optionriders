//@version=6
indicator("OptionRiders Supply & Demand Pro V36", overlay=true, max_boxes_count=500, max_labels_count=500, max_lines_count=500)

// Guarantee enough history for drawing objects whose x1 may reference bars
// up to 1800 back (key level lines starting from their source candle).
max_bars_back(high,  2000)
max_bars_back(low,   2000)
max_bars_back(close, 2000)
max_bars_back(open,  2000)
max_bars_back(time,  2000)

// ══════════════════════════════════════════════════════════════════════════════
// ██  INPUTS
// ══════════════════════════════════════════════════════════════════════════════

// ── 1. Smart Money ────────────────────────────────────────────────────────────
G4          = "🧠 Smart Money"
showBOS     = input.bool(true,  "Show BOS / CHoCH",                        group=G4)
showChoch   = input.bool(false, "  └ Show Reversal Labels",                 group=G4, tooltip="Show or hide the 'Reversal' label when a Change of Character (CHoCH) is detected. Turn off to reduce chart noise.")
chochMinATR = input.float(1.0,  "  └ Min Reversal Move (× ATR)",            group=G4, minval=0.1, maxval=5.0, step=0.1, tooltip="The CHoCH break must exceed this multiple of ATR to show a Reversal label. Higher = fewer, more significant reversals only. Default 1.0 means the break must be at least 1× ATR.")
showFVG     = input.bool(true, "Show Fair Value Gaps",        group=G4)
maxFVG      = input.int(8,     "Max FVGs",                   minval=3, maxval=20, group=G4)
showLiquid  = input.bool(true, "Show Liquidity Levels",      group=G4)
eqlTol      = input.float(0.02, "Equal Level Tolerance (%)",  minval=0.01, maxval=1.0, step=0.01, group=G4)
eqlLookback = input.int(6,     "Equal Level Lookback",        minval=5, maxval=100, group=G4)

// ── 2. Entry Signals ──────────────────────────────────────────────────────────
GS          = "🎯 Entry Signals"
showSignals = input.bool(true,  "Show Entry Signals",         group=GS)
showLongSig = input.bool(false, "  └ Show Long Signals",      group=GS)
showShortSig= input.bool(false, "  └ Show Short Signals",     group=GS)
sigMinConf  = input.int(4,      "Min Confluence Score (maåx 7)", minval=1, maxval=7, group=GS, tooltip="How many confluence factors must agree before a Break & Retest signal fires. Note: HTF is not scored for BnR (max achievable is 6). Default 4 is recommended.")
sigUseTrend = input.bool(true,  "Factor 1 — Trend Aligned",   group=GS, tooltip="Long only fires when market structure is bullish (BOS up). Short only when bearish (BOS down).")
sigUseVWAP  = input.bool(true,  "Factor 2 — VWAP Side",       group=GS, tooltip="Long requires close > VWAP. Short requires close < VWAP.")
sigUseKZ    = input.bool(false, "Factor 3 — Session Killzone", group=GS, tooltip="Signal only valid during the London or New York killzone window.")
sigUseMajor = input.bool(true,  "Factor 4 — At Key Level",    group=GS, tooltip="The zone overlaps a key price level (PDH, PDL, TWH, PWH, etc.).")
sigUseHTF   = input.bool(true,  "Factor 5 — HTF Zone",        group=GS, tooltip="Zone was detected on the higher timeframe (if MTF is enabled).")
sigUseSt    = input.bool(true,  "Factor 6 — Structural Zone", group=GS, tooltip="Zone formed at a BOS or CHoCH swing point.")
sigUseClose = input.bool(true,  "Factor 7 — Confirmation Close", group=GS, tooltip="Long requires the signal bar to close bullish (green). Short requires a bearish (red) close. Filters out wicks with no follow-through.")

// ── 3. EMA Clouds ─────────────────────────────────────────────────────────────
GC          = "☁ EMA Clouds"
showClouds  = input.bool(true,  "Show EMA Clouds",            group=GC)
