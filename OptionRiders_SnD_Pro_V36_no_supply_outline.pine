lvlWidON    = input.float(1.0,  "  └ PMH/PML Width",         minval=0.5, maxval=10, step=0.5, group=G9)
lvlStyle    = input.string("Solid", "Level Line Style", options=["Solid", "Dotted", "Dashed"], group=G9)
lvlLen      = input.int(200,   "Level Line Length (bars)",   minval=10, maxval=490, group=G9, tooltip="How far left the key level lines extend from current bar. Lines always extend to the right edge.")
lvlBlockH   = input.float(0.2, "S/R Block Thickness (×ATR)", minval=0.01, maxval=1.0, step=0.01, group=G9, tooltip="Height of the coloured support/resistance block under each key level, as a multiple of ATR. Lower = thinner. Set to 0.01 for a hairline.")
lvlConfMode = input.bool(true, "Fade levels · darken clusters", group=G9, tooltip="Draw every key level faint by default, then render it dark only when it clusters with other levels within the distance below. Makes stacked confluence pop while lone levels stay out of the way.")
lvlConfATR  = input.float(0.4, "  └ Cluster Distance (×ATR)",   minval=0.05, maxval=3.0, step=0.05, group=G9, tooltip="Two or more levels within this many ATRs of each other count as a confluence cluster and render dark. Isolated levels render faint. Because it scales with ATR, one value works on any instrument — ES, NQ, or a single stock — no retuning needed.")
lvlFaintT   = input.int(82,    "  └ Faint Transparency",       minval=0, maxval=100, group=G9, tooltip="Transparency for isolated levels. Higher = lighter. 0 = solid, 100 = invisible.")
lvlClustT   = input.int(12,    "  └ Cluster Transparency",     minval=0, maxval=100, group=G9, tooltip="Transparency for levels that are part of a confluence cluster. Lower = darker/bolder.")
lvlOldFade  = input.bool(true, "  └ Wash out levels > 1 week old", group=G9, tooltip="Levels whose source candle is more than one week old fade toward near-white so only fresh levels carry weight. Takes priority over cluster darkening for stale levels.")
lvlOldT     = input.int(90,    "  └ Old-Level Transparency",     minval=0, maxval=100, group=G9, tooltip="Transparency for levels older than a week. Higher = lighter / more washed out. 90 = a faint ghost line.")
lvlOldCol   = input.color(#FFFFFF, "  └ Old-Level Color",        group=G9, tooltip="Colour for levels older than a week. Defaults to white — set it to anything you like. Its transparency is driven by 'Old-Level Transparency' above, not by this picker.")

