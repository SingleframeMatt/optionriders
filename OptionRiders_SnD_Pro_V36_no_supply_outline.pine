lvlColDOWPW = input.color(color.new(#90A4AE, 60), "  └ Prev Week Color",      group=GDOW)
lvlWidDOWPW = input.float(1.0,  "  └ Prev Week Width",            minval=0.5, maxval=10, step=0.5, group=GDOW)
dowConfTol  = input.float(1.5, "  └ Confluence Tolerance (×ATR)", minval=0.5, maxval=5.0, step=0.5, group=GDOW, tooltip="A prev-week daily low is only drawn if it landed within this many ATRs of the same day's low in at least one of the prior 3 weeks. Filters out one-off levels so only repeated, proven lows show.")

